<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Airflow Analysis Report</title>
<style>
  :root {
    --fg: #1f2933;
    --muted: #5b6772;
    --bg: #fafbfc;
    --accent: #2b6cb0;
    --border: #e1e4e8;
  }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
         margin: 24px; color: var(--fg); background: var(--bg); }
  h1 { border-bottom: 2px solid var(--accent); padding-bottom: 6px; }
  h2 { margin-top: 36px; border-bottom: 1px solid var(--border); padding-bottom: 4px; }
  h3 { margin-top: 24px; color: var(--accent); }
  h4 { margin-top: 18px; color: var(--muted); }
  table { border-collapse: collapse; margin: 8px 0 16px 0; font-size: 12px; }
  th, td { border: 1px solid var(--border); padding: 4px 8px; text-align: right; }
  th { background: #eef1f5; text-align: center; }
  td.lbl, th.lbl { text-align: left; }
  .plot { margin: 8px 0 18px 0; max-width: 100%; }
  .plot img { max-width: 100%; height: auto; border: 1px solid var(--border); background: white; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .insight { background: #fffaeb; border-left: 4px solid #d4a017; padding: 8px 12px; margin: 6px 0; }
  .meta { color: var(--muted); font-size: 13px; }
  .notes { background: #f6f8fa; padding: 10px 14px; border-radius: 4px; white-space: pre-wrap; font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
  details > summary { cursor: pointer; color: var(--accent); margin: 6px 0; }
  .tag { display: inline-block; background: #e1efff; color: var(--accent);
         border-radius: 3px; padding: 1px 6px; font-size: 11px; margin-right: 4px; }

  /* Cooling KPI banner */
  .kpi-banner { background: linear-gradient(135deg, #e6f0fb 0%, #f5f0ff 100%);
                border: 1px solid #c7d6ea; border-radius: 8px;
                padding: 18px 22px; margin: 18px 0 8px 0; }
  .kpi-banner h2 { border: none; margin: 0 0 6px 0; padding: 0;
                   color: var(--accent); font-size: 20px; }
  .kpi-banner .verdict { font-size: 15px; color: var(--fg); margin: 4px 0 14px 0; }
  .kpi-banner .verdict strong { color: var(--accent); }
  .kpi-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
               gap: 12px; margin-top: 8px; }
  .kpi-card { background: white; border: 1px solid var(--border);
              border-radius: 6px; padding: 10px 14px; }
  .kpi-card .label { font-size: 11px; color: var(--muted); text-transform: uppercase;
                     letter-spacing: 0.04em; }
  .kpi-card .value { font-size: 22px; font-weight: 600; color: var(--fg);
                     margin-top: 2px; }
  .kpi-card .sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .kpi-card.winner { border-color: #2b6cb0; background: #f0f6fc; }
  .kpi-card.winner .value { color: var(--accent); }
  .kpi-section table { width: 100%; }
  .kpi-section th.first, .kpi-section td.first { text-align: left; }
  .kpi-section tr.winner-row { background: #f0f6fc; }
  .kpi-section tr.winner-row td.first::before { content: "\2605  "; color: var(--accent); }
  .kpi-legend { font-size: 12px; color: var(--muted); margin: 10px 0 0 0; }
  .kpi-legend li { margin: 2px 0; }
</style>
</head>
<body>

<h1>Airflow Analysis Report</h1>
<p class="meta">Generated {{ generated_at }} from {{ root }}.</p>

{% if cooling and cooling.summary_rows %}
<section class="kpi-banner kpi-section">
  <h2>Cooling Performance &mdash; Headline KPIs</h2>
  {% if cooling.multi and cooling.winner %}
    <p class="verdict">
      Best cooling per resource utilization:
      <strong>Config {{ cooling.winner }}</strong>
      (score {{ cooling.ranking[0].score_fmt }} / 100).
      Higher cooling score = lower hotspot rise over ambient and lower
      fan RPM under load.
    </p>
  {% else %}
    <p class="verdict">
      Single config measured. Add more <code>Config X/</code> folders to
      rank them; metrics below already show this config's cooling efficiency
      independent of workload.
    </p>
  {% endif %}

  {# Top-line KPI cards: one per config, showing the headline score and the
     two most decision-relevant numbers (CPU/GPU temp rise over ambient and
     fan RPM under load). #}
  <div class="kpi-cards">
    {% for row in cooling.summary_rows %}
      {% set is_winner = cooling.winner == row.name %}
      <div class="kpi-card {% if is_winner %}winner{% endif %}">
        <div class="label">Config {{ row.name }} &middot; Cooling Score
          {% if not row.cooling_score_is_v5 %}
            <span class="tag" title="V5 matched-quantile gating could not score this capture (likely too short or too idle); falling back to legacy V0 formula. Not directly comparable to other V5 scores.">V0 fallback</span>
          {% endif %}
        </div>
        <div class="value">{{ row.fmt.cooling_score }} / 100</div>
        <div class="sub">
          CPU rise {{ row.fmt.cpu_rise }} &middot;
          GPU rise {{ row.fmt.gpu_rise }}<br>
          Fans @ load: {{ row.fmt.high_load_fan_rpm_total }} &middot;
          Ambient {{ row.fmt.ambient_median }}<br>
          Workload intensity: {{ row.fmt.workload_score }} / 100
          (CPU {{ row.fmt.workload_cpu_clock_ghz }} @ {{ row.fmt.workload_cpu_vcore_v }},
           {{ row.fmt.workload_cpu_pkg_w }};
           GPU {{ row.fmt.workload_gpu_clock_mhz }} @ {{ row.fmt.workload_gpu_voltage_v }},
           {{ row.fmt.workload_gpu_pkg_w }})
        </div>
      </div>
    {% endfor %}
  </div>

  <h3 style="margin-top: 22px;">Cooling KPIs per configuration</h3>
  <table>
    <thead>
      <tr>
        <th class="first lbl">Config</th>
        <th>Cooling score<br>(higher = better)</th>
        <th>Ambient<br>(System sensor)</th>
        <th>CPU @ high load<br>median</th>
        <th>CPU rise<br>over ambient</th>
        <th>CPU cooling<br>efficiency (C/W)</th>
        <th>CPU headroom<br>to 95 C (p95)</th>
        <th>GPU hotspot @ high load<br>median</th>
        <th>GPU rise<br>over ambient</th>
        <th>GPU cooling<br>efficiency (C/W)</th>
        <th>GPU headroom<br>to 90 C (p95)</th>
        <th>Total fan RPM<br>@ high load</th>
        <th>Workload intensity<br>(0..100, higher = harder)</th>
        <th>% samples<br>at high load</th>
      </tr>
    </thead>
    <tbody>
      {% for row in cooling.summary_rows %}
        {% set is_winner = cooling.winner == row.name %}
        <tr class="{% if is_winner %}winner-row{% endif %}">
          <td class="first lbl"><strong>Config {{ row.name }}</strong></td>
          <td>{{ row.fmt.cooling_score }}</td>
          <td>{{ row.fmt.ambient_median }}</td>
          <td>{{ row.fmt.cpu_high_load_median }}</td>
          <td>{{ row.fmt.cpu_rise }}</td>
          <td>{{ row.fmt.cpu_c_per_w }}</td>
          <td>{{ row.fmt.cpu_headroom }}</td>
          <td>{{ row.fmt.gpu_high_load_median }}</td>
          <td>{{ row.fmt.gpu_rise }}</td>
          <td>{{ row.fmt.gpu_c_per_w }}</td>
          <td>{{ row.fmt.gpu_headroom }}</td>
          <td>{{ row.fmt.high_load_fan_rpm_total }}</td>
          <td>{{ row.fmt.workload_score }}<br>
              <span style="font-size:10px;color:var(--muted)">
                CPU {{ row.fmt.workload_cpu_intensity }} /
                GPU {{ row.fmt.workload_gpu_intensity }}
              </span></td>
          <td>{{ row.fmt.high_load_fraction_pct }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <details>
    <summary>Workload intensity detail (clocks, voltages, power under load)</summary>
    <table>
      <thead>
        <tr>
          <th class="first lbl">Config</th>
          <th>Intensity score</th>
          <th>CPU intensity</th>
          <th>CPU clock</th>
          <th>CPU Vcore</th>
          <th>CPU pkg power</th>
          <th>GPU intensity</th>
          <th>GPU clock</th>
          <th>GPU voltage</th>
          <th>GPU pkg power</th>
        </tr>
      </thead>
      <tbody>
        {% for row in cooling.summary_rows %}
          <tr>
            <td class="first lbl"><strong>Config {{ row.name }}</strong></td>
            <td>{{ row.fmt.workload_score }} / 100</td>
            <td>{{ row.fmt.workload_cpu_intensity }} / 100</td>
            <td>{{ row.fmt.workload_cpu_clock_ghz }}</td>
            <td>{{ row.fmt.workload_cpu_vcore_v }}</td>
            <td>{{ row.fmt.workload_cpu_pkg_w }}</td>
            <td>{{ row.fmt.workload_gpu_intensity }} / 100</td>
            <td>{{ row.fmt.workload_gpu_clock_mhz }}</td>
            <td>{{ row.fmt.workload_gpu_voltage_v }}</td>
            <td>{{ row.fmt.workload_gpu_pkg_w }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </details>

  <details>
    <summary>Per-hotspot detail (median, p95, rise, C/W, headroom)</summary>
    <table>
      <thead>
        <tr>
          <th class="first lbl">Config</th>
          <th class="first lbl">Hotspot</th>
          <th>Median (C)</th>
          <th>Median @ high load (C)</th>
          <th>p95 (C)</th>
          <th>Rise over ambient (C)</th>
          <th>Median power (W)</th>
          <th>Cooling eff. (C/W)</th>
          <th>Headroom to throttle (C)</th>
        </tr>
      </thead>
      <tbody>
        {% for row in cooling.detail_rows %}
          <tr>
            <td class="first lbl">{{ row.config }}</td>
            <td class="first lbl">{{ row.hotspot }}</td>
            <td>{{ row.fmt.median }}</td>
            <td>{{ row.fmt.high_load_median }}</td>
            <td>{{ row.fmt.p95 }}</td>
            <td>{{ row.fmt.rise_over_ambient }}</td>
            <td>{{ row.fmt.median_power_w }}</td>
            <td>{{ row.fmt.c_per_watt }}</td>
            <td>{{ row.fmt.headroom }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </details>

  <ul class="kpi-legend">
    <li><strong>Cooling score (V5, 0..100, higher is better):</strong>
        80% temperature rise over ambient + 20% total fan RPM. Inside the
        temperature term: CPU 0.55, GPU 0.30, VRM 0.15 (CPU dominates because
        a sub-optimal CPU heatsink is the typical airflow bottleneck).
        Anchors: 0&nbsp;C rise &rarr; 100, 40&nbsp;C &rarr; 0;
        0&nbsp;RPM &rarr; 100, 8000&nbsp;RPM &rarr; 0.</li>
    <li><strong>Matched-quantile gate:</strong> the score only looks at each
        config's <em>own</em> top 30% busiest CPU samples (for CPU rise) and
        top 30% busiest GPU samples (for GPU rise). Each capture is judged on
        its own busiest moments, so two configs measured under different
        workloads still get an apples-to-apples comparison.</li>
    <li><strong>Idle-component drop:</strong> if a component's
        70th-percentile load is &lt; 5% (effectively idle for the whole
        capture), V5 removes that component from the temperature term and
        renormalizes the remaining weights. This stops a config that
        happened to be GPU-idle from getting a free "0 GPU rise" credit.</li>
    <li><strong>Workload intensity (0..100):</strong> mean of CPU and GPU
        sub-scores. Each sub-score averages clock, voltage and power scaled
        against typical desktop maxima (CPU: 5.0 GHz, 0.9&ndash;1.4 V, 150 W;
        GPU: 3.0 GHz, 0.7&ndash;1.1 V, 350 W). Reported for context; V5 does
        NOT use this for compensation (matched-quantile gating handles
        cross-capture fairness on its own).</li>
    <li><strong>Rise over ambient (C):</strong> hotspot median minus the
        motherboard "System" sensor. Cancels out room-temperature differences
        between sessions.</li>
    <li><strong>Cooling efficiency (C/W):</strong> rise over ambient divided
        by that component's median power draw while loaded. Lower = the
        cooler removes more heat per watt produced.</li>
    <li><strong>High load (used by KPI tables, not by V5):</strong> samples
        where CPU load &ge; 10% <em>or</em> GPU load &ge; 30%. The CPU gate
        is intentionally low because a powerful CPU heats up even at light
        loads; the GPU gate is higher because GPUs stay cool until they're
        actively rendering. The per-hotspot KPI tables below still use this
        gate so their numbers stay stable across releases; only the headline
        cooling score uses V5's matched-quantile gate.</li>
    <li><strong>Headroom to throttle (C):</strong> distance from the 95th
        percentile temperature to the throttling threshold
        (CPU 95 C, GPU hot spot 90 C, VRM 100 C). Bigger = safer.</li>
  </ul>
</section>
{% endif %}

{% if cooling and cooling.variants %}
<section class="kpi-section">
  <details>
    <summary><strong>Score sensitivity (V0&ndash;V5 variants)</strong> &mdash;
      how the score moves under different "high resource utilization"
      definitions</summary>
    <p class="meta" style="margin-top: 8px;">
      <strong>V5</strong> is the production score shown above. The other
      variants are listed for transparency: each redefines what counts as
      "high load" and shows how that choice moves the ranking. If V5 and the
      other variants disagree, the disagreement itself is the signal &mdash;
      it tells you which captures aren't directly comparable.
    </p>
    <table>
      <thead>
        <tr>
          <th class="first lbl">Config</th>
          {% for vid in cooling.variant_ids %}
            <th>{{ vid }}{% if vid == 'V5' %} (production){% elif vid == 'V4' %}*{% endif %}</th>
          {% endfor %}
          <th>V5 CPU mask</th>
          <th>V5 GPU mask</th>
        </tr>
      </thead>
      <tbody>
        {% for row in cooling.variants %}
          <tr {% if cooling.winner == row.name %}class="winner-row"{% endif %}>
            <td class="first lbl"><strong>Config {{ row.name }}</strong></td>
            {% for vid in cooling.variant_ids %}
              <td>{{ row.cells[vid].score_fmt }}</td>
            {% endfor %}
            <td>{{ row.cells['V5'].cpu_coverage_fmt }}</td>
            <td>{{ row.cells['V5'].gpu_coverage_fmt }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <details style="margin-top: 8px;">
      <summary>Per-variant sub-scores (CPU/GPU/VRM rise, fan RPM)</summary>
      <table>
        <thead>
          <tr>
            <th class="first lbl">Config</th>
            <th>Variant</th>
            <th>Score</th>
            <th>Temp term</th>
            <th>RPM term</th>
            <th>Weighted rise</th>
            <th>CPU rise</th>
            <th>GPU rise</th>
            <th>VRM rise</th>
            <th>Total fan RPM</th>
            <th>n samples</th>
          </tr>
        </thead>
        <tbody>
          {% for row in cooling.variants %}
            {% for vid in cooling.variant_ids %}
              {% set v = row.cells[vid] %}
              <tr>
                {% if loop.first %}
                  <td class="first lbl" rowspan="{{ cooling.variant_ids|length }}">
                    <strong>Config {{ row.name }}</strong>
                  </td>
                {% endif %}
                <td class="lbl">{{ v.label }}</td>
                <td>{{ v.score_fmt }}</td>
                <td>{{ v.temp_score_fmt }}</td>
                <td>{{ v.rpm_score_fmt }}</td>
                <td>{{ v.weighted_rise_fmt }}</td>
                <td>{{ v.cpu_rise_fmt }}</td>
                <td>{{ v.gpu_rise_fmt }}</td>
                <td>{{ v.vrm_rise_fmt }}</td>
                <td>{{ v.high_total_rpm_fmt }}</td>
                <td>{{ "{:,}".format(v.n_samples) }}</td>
              </tr>
            {% endfor %}
          {% endfor %}
        </tbody>
      </table>
    </details>

    <ul class="kpi-legend">
      <li><strong>V0 legacy:</strong> pre-V5 production formula (temp 0.70 +
          rpm 0.30, weights cpu 4/7 / gpu 3/7 / vrm 1/7, current absolute gate
          [CPU&ge;10% or GPU&ge;30%], with -10&nbsp;C&times;intensity
          forgiveness). Shown so you can see how V5 reranks the same data.</li>
      <li><strong>V1 tight:</strong> tight load gate (CPU&ge;70% or
          GPU&ge;70%); legacy weights and forgiveness. If a config has very
          few samples in this range, the score is unreliable &mdash; check the
          n column.</li>
      <li><strong>V2 intensity:</strong> samples where the per-sample workload
          intensity (clock/Vcore/W blend) &ge; 0.7; legacy weights and
          forgiveness. Useful when CPU and GPU loads disagree about how busy
          the system actually is.</li>
      <li><strong>V3 no-forgive:</strong> current gate, legacy weights, but
          workload-intensity forgiveness removed. Shows what V0 would say if
          it didn't credit configs for being measured under heavy work.</li>
      <li><strong>V4 intensity*:</strong> WorkloadIntensity score itself
          (clocks/Vcore/W blend, 0..100). <em>Not</em> a cooling score &mdash;
          listed to confirm captures are under similar silicon pressure
          (similar V4 across configs = comparison is fair).</li>
      <li><strong>V5 production:</strong> per-component matched-quantile
          masks (top 30% of own samples), weights cpu=0.55 / gpu=0.30 /
          vrm=0.15 (temp=0.80 / rpm=0.20). Components whose 70th-percentile
          load is &lt; 5% are dropped from the temp term ("idle" in the V5
          mask columns). Best for ranking captures with different workload
          distributions.</li>
    </ul>
  </details>
</section>
{% endif %}

<h2>1. Overview</h2>
<table>
  <thead>
    <tr><th class="lbl">Config</th><th>CSVs</th><th>Rows</th>
        <th>Sample period (s)</th><th>Sensors</th><th>Has fan map</th></tr>
  </thead>
  <tbody>
  {% for c in configs %}
    <tr>
      <td class="lbl"><strong>Config {{ c.name }}</strong></td>
      <td>{{ c.n_csvs }}</td>
      <td>{{ "{:,}".format(c.n_rows) }}</td>
      <td>{{ "%.2f"|format(c.sample_period_s) if c.sample_period_s == c.sample_period_s else "n/a" }}</td>
      <td>{{ c.n_sensors }}</td>
      <td>{{ "yes" if c.has_fan_map else "no" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{% if insights %}
<h2>2. Insights</h2>
{% for ins in insights %}
  <div class="insight">{{ ins }}</div>
{% endfor %}
{% endif %}

<h2>3. Per-Configuration Details</h2>
{% for c in configs %}
  <h3>Config {{ c.name }}</h3>
  <details><summary>Setup notes</summary>
    <div class="notes">{{ c.notes or "(empty setup.md)" }}</div>
    {% if c.fan_map %}
      <p class="meta">Fan map:
        {% for header, slot in c.fan_map.items() %}<span class="tag">{{ header }} &rarr; {{ slot }}</span>{% endfor %}
      </p>
    {% endif %}
  </details>

  <h4>Sensor summary (key channels)</h4>
  {{ c.summary_html|safe }}

  {% if c.plot_violin %}
  <h4>Hotspot temperature distributions</h4>
  <div class="plot"><img alt="violin temps" src="data:image/png;base64,{{ c.plot_violin }}"></div>
  {% endif %}

  <div class="grid">
    {% if c.plot_cpu_load_bins %}
      <div class="plot"><img alt="cpu load bins" src="data:image/png;base64,{{ c.plot_cpu_load_bins }}"></div>
    {% endif %}
    {% if c.plot_gpu_load_bins %}
      <div class="plot"><img alt="gpu load bins" src="data:image/png;base64,{{ c.plot_gpu_load_bins }}"></div>
    {% endif %}
  </div>

  {% if c.plot_fan_curves %}
    <h4>Fan curves vs hotspot temperatures</h4>
    <div class="grid">
    {% for img in c.plot_fan_curves %}
      <div class="plot"><img alt="fan curve" src="data:image/png;base64,{{ img }}"></div>
    {% endfor %}
    </div>
  {% endif %}

  {% if c.plot_corr %}
    <h4>Correlation heatmap (Spearman, |r| &ge; 0.3)</h4>
    <p class="meta">Black cells mark |r| = 1: the diagonal (trivially self-correlated)
    plus any off-diagonal pair that carries no extra information beyond the other.
    Note: raw correlation between fan RPM and temperature can be misleading because
    fans ramp <em>up</em> when temperatures rise &mdash; see the Fan Impact Matrix
    below for a controlled answer to "which fan cools which sensor".</p>
    <div class="plot"><img alt="corr heatmap" src="data:image/png;base64,{{ c.plot_corr }}"></div>
  {% endif %}

  {% if c.plot_fan_impact %}
    <h4>Fan Impact Matrix &mdash; which fan cools which sensor</h4>
    <p class="meta">
      Each cell is the change in that temperature (in &deg;C) per +1000 RPM of
      that fan, <em>after</em> controlling for CPU load, GPU load, CPU package
      power, GPU package power, ambient (System sensor), and every other fan in
      the case. Restricted to warm samples (CPU load &ge; 10% or GPU load &ge;
      30%). <strong>Negative (blue) = cooling.</strong> More negative is better.
      Cells with a hatch pattern have low tolerance (this fan moves nearly
      identically to another fan in the data, so its individual effect can't be
      separated reliably; the sign is OK but the magnitude isn't).
    </p>
    <div class="plot"><img alt="fan impact matrix" src="data:image/png;base64,{{ c.plot_fan_impact }}"></div>

    {% if c.fan_impact_best %}
      <h4>Best fan per temperature target</h4>
      <table>
        <thead>
          <tr>
            <th class="lbl">Temperature target</th>
            <th class="lbl">Most-cooling fan</th>
            <th>C per +1000 RPM</th>
            <th>Tolerance</th>
            <th>n</th>
          </tr>
        </thead>
        <tbody>
          {% for row in c.fan_impact_best %}
            <tr>
              <td class="lbl">{{ row.target }}</td>
              <td class="lbl">{{ row.fan }}</td>
              <td>{{ row.fmt.c_per_1000_rpm }}</td>
              <td>{{ row.fmt.tolerance }}</td>
              <td>{{ row.n }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}

    {% if c.fan_impact_r2 %}
      <details>
        <summary>Regression fit quality (R&sup2; per target)</summary>
        <table>
          <thead>
            <tr><th class="lbl">Temperature target</th><th>R&sup2;</th></tr>
          </thead>
          <tbody>
            {% for row in c.fan_impact_r2 %}
              <tr><td class="lbl">{{ row.target }}</td><td>{{ row.r2_fmt }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
        <p class="meta">R&sup2; near 1.0 means load + power + ambient + fans
        explain almost all of that target's variance under load. Low R&sup2;
        means there's something going on the model can't see (turbulence,
        dust, GPU memory access patterns, etc.) and the fan coefficients
        should be read with that caveat.</p>
      </details>
    {% endif %}

    {% if c.fan_impact_rows %}
      <details>
        <summary>Full fan-impact table</summary>
        <table>
          <thead>
            <tr>
              <th class="lbl">Fan</th>
              <th class="lbl">Target</th>
              <th>C per +1000 RPM</th>
              <th>Tolerance</th>
              <th>n</th>
            </tr>
          </thead>
          <tbody>
            {% for row in c.fan_impact_rows %}
              <tr>
                <td class="lbl">{{ row.fan }}</td>
                <td class="lbl">{{ row.target }}</td>
                <td>{{ row.fmt.c_per_1000_rpm }}</td>
                <td>{{ row.fmt.tolerance }}</td>
                <td>{{ row.n }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </details>
    {% endif %}

    {% if c.fan_impact_notes %}
      {% for note in c.fan_impact_notes %}
        <p class="insight" style="background:#fff5f5;border-left-color:#c0392b">{{ note }}</p>
      {% endfor %}
    {% endif %}
  {% endif %}

  {% if c.lag_html %}
    <h4>Load &rarr; temperature lag (Pearson at best lag)</h4>
    {{ c.lag_html|safe }}
  {% endif %}

  {% if c.plot_timeline %}
    <h4>Hotspot timeline</h4>
    <div class="plot"><img alt="timeline" src="data:image/png;base64,{{ c.plot_timeline }}"></div>
  {% endif %}
{% endfor %}

{% if comparison and comparison.configs|length > 1 %}
<h2>4. Cross-Configuration Comparison</h2>
<p class="meta">Baseline: <strong>Config {{ comparison.baseline }}</strong>. Deltas below are
<em>other minus baseline</em> at matched load deciles; negative values mean the other config runs cooler.</p>

<h3>4a. Matched-load median temperatures</h3>
<div class="grid">
{% for img in comparison.matched_plots %}
  <div class="plot"><img alt="matched temps" src="data:image/png;base64,{{ img }}"></div>
{% endfor %}
</div>

<h3>4b. Delta heatmaps (vs baseline)</h3>
<div class="grid">
{% for img in comparison.delta_plots %}
  <div class="plot"><img alt="delta heatmap" src="data:image/png;base64,{{ img }}"></div>
{% endfor %}
</div>

<h3>4c. Fan efficiency (slope of temp vs RPM under load)</h3>
{% if comparison.fan_eff_html %}
  {{ comparison.fan_eff_html|safe }}
{% else %}
  <p class="meta">Not enough variation to estimate fan slopes.</p>
{% endif %}
{% endif %}

<p class="meta" style="margin-top: 40px">airflow_stats v{{ version }}</p>
</body>
</html>
